, function () {\n    if (shopOpen) {\n        if (attack < 20 && coins >= attack * 30) {\n            coins -= attack * 30\n            attack += 1\n            game.showLongText(\"공격력 업! 공격력: \" + attack, DialogLayout.Bottom)\n        } else {\n            game.showLongText(\"코인이 부족하거나 최대 레벨이야.\", DialogLayout.Bottom)\n        }\n        shopOpen = false\n        updateText()\n    } else {\n        attackMonster()\n    }\n})\n\n// B: 상점 열기\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\n    shopOpen = true\n    game.showLongText(\n        \"상점!\\nA: 공격력 +1\\n가격: \" + (attack * 30) + \" 코인\",\n        DialogLayout.Bottom\n    )\n})\n\n// 스킬: A+B 같이 누르기\ncontroller.AB.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (skillReady && !shopOpen) {\n        skillReady = false\n\n        let skillDamage = attack * (2 + skillLevel)\n        monsterHp -= skillDamage\n\n        monster.startEffect(effects.ashes, 500)\n        game.showLongText(\"파워 스킬! \" + skillDamage + \" 데미지!\", DialogLayout.Bottom)\n\n        if (monsterHp <= 0) {\n            let reward = 10 + level * 5 + luck\n            coins += reward\n            newMonster()\n        } else {\n            updateText()\n        }\n\n        pause(3000)\n        skillReady = true\n        game.showLongText(\"스킬 준비 완료!\", DialogLayout.Bottom)\n    }\n})\n\ngame.splash(\"성장형 몬스터 게임\")\ngame.showLongText(\n    \"A: 공\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":228,"length1":79,"diffs":[[1,"    \"preferredEditor\": \"pyprj\"\n"]]}]},{"type":"added","filename":"test.ts","value":"// 테스트는 여기로 이동합니다; 이 패키지가 확장으로 사용될 때 컴파일되지 않을 것 입니다.\n"}]}],"snapshots":[{"timestamp":1782102984145,"editorVersion":"4.0.14","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block>\n</xml>","main.ts":" ","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"duck\",\n    \"description\": \"\